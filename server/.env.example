# 복사해서 .env 로 쓰세요:  cp .env.example .env
# .env 는 .gitignore 에 들어 있습니다. 실제 값은 절대 커밋하지 마세요.

# WebDAV 를 열 주소 — 서버의 VPN(Tailscale 등) IP. 0.0.0.0 금지.
BIND_IP=100.x.y.z

# 호스트 쪽 포트
DAV_PORT=8095

# 컨테이너 전용 서브넷 — 서버에서 안 쓰는 대역으로
DAV_SUBNET=172.31.250.0/24

# firewall.sh 용 — 북마크를 동기화하는 기기(브라우저 PC)의 VPN IP
ALLOWED_CLIENT_IP=100.a.b.c
